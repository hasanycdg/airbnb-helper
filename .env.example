# ─────────────────────────────────────────────────────────────
# StayGuide Pro — environment configuration
# Copy to `.env` and fill in. The app runs with sensible fallbacks
# even when the optional integrations below are left blank.
# ─────────────────────────────────────────────────────────────

# Core ----------------------------------------------------------
# PostgreSQL connection string (Prisma).
DATABASE_URL="postgresql://stayguide:stayguide@localhost:5432/stayguide?schema=public"

# Public base URL of the app (used for guest links, QR codes, emails).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-insecure-secret-change-me-in-production-0000"

# AI (OpenAI) — optional ---------------------------------------
# When unset, the AI assistant falls back to a deterministic
# rules-based responder so the app still works offline.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Stripe — optional --------------------------------------------
# When unset, billing runs in "mock" mode (plans can be switched
# without a real Stripe account).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PREMIUM=""
STRIPE_PRICE_MANAGER=""

# Email (Resend) — optional ------------------------------------
# When unset, emails are logged to the server console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="StayGuide Pro <hello@example.com>"

# Object storage (S3-compatible) — optional -------------------
# When unset, uploads are stored on the local filesystem under
# /public/uploads and served directly (dev only).
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="stayguide-media"
S3_PUBLIC_URL=""
