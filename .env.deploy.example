# ── StayGuide Pro — test deployment env for `docker compose` ──
# On the server:  cp .env.deploy.example .env  then edit the two required vars.

# Your server's PUBLIC IP in nip.io form (dots are fine).
# Example: server IP 203.0.113.9  →  203.0.113.9.nip.io
DOMAIN=YOUR.SERVER.IP.nip.io

# Session signing secret — REQUIRED. Generate a fresh one:
#   openssl rand -base64 32
AUTH_SECRET=

# Password for the bundled Postgres container.
POSTGRES_PASSWORD=change-this-password

# Seed demo data on first boot (login: owner@demo-tirol.test / password123).
# Set to false after the first successful start to avoid reseeding.
SEED_ON_START=true

# ── Optional integrations (leave blank → offline fallbacks) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESEND_API_KEY=
EMAIL_FROM=StayGuide Pro <hello@example.com>
